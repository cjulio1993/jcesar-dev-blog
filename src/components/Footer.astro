---
import { copy, socialLinks } from '@/data/site';
import { localeFromPath, localizedPath } from '@/i18n';

const locale = localeFromPath(Astro.url.pathname);
const t = copy[locale];
---

<footer class="site-footer">
  <div class="container-shell footer-grid">
    <div>
      <a href={localizedPath(locale)} class="brand-mark"><span class="brand-bracket">{`{`}</span>JC<span class="brand-dot">.</span>dev<span class="brand-bracket">{`}`}</span></a>
      <p class="footer-copy">{t.meta.description}</p>
    </div>
    <div class="footer-nav">
      <a href={localizedPath(locale, 'projects')}>{t.nav.projects}</a>
      <a href={localizedPath(locale, 'about')}>{t.nav.about}</a>
      <a href={localizedPath(locale, 'blog')}>{t.nav.blog}</a>
      <a href={localizedPath(locale, 'contact')}>{t.nav.contact}</a>
    </div>
    <div class="footer-social">
      <a href={socialLinks.github} target="_blank" rel="noreferrer">GitHub ↗</a>
      <a href={socialLinks.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a>
      <a href={localizedPath(locale, 'rss.xml')}>RSS</a>
    </div>
  </div>
  <div class="container-shell footer-bottom">
    <p>© {new Date().getFullYear()} Julio Cesar</p>
    <p>Built with Astro · Deployed on Vercel</p>
  </div>
</footer>

---
import type { Locale } from '@/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const label = locale === 'pt-br' ? 'Do código à realidade.' : locale === 'es' ? 'Del código a la realidad.' : 'From code to reality.';
---
<div class="code-universe" aria-label={label}>
  <div class="universe-topline"><span>JC / ENGINEERING LAB</span><span class="live-indicator">LIVE</span></div>
  <div class="orbital-scene" aria-hidden="true">
    <div class="orbital-grid"></div>
    <div class="orbit orbit-one"><span class="orbit-node"></span></div>
    <div class="orbit orbit-two"><span class="orbit-node"></span></div>
    <div class="orbit orbit-three"><span class="orbit-node"></span></div>
    <div class="code-core"><span>&lt;/&gt;</span><small>BUILD. SOLVE. EVOLVE.</small></div>
    <span class="floating-code code-php">PHP :: Laravel</span>
    <span class="floating-code code-api">API → SYSTEM</span>
    <span class="floating-code code-rust">Rust + Python</span>
    <span class="scene-coordinate">X: 023 / Y: 017 / Z: 001</span>
  </div>
  <div class="lab-terminal">
    <div class="terminal-bar"><div class="code-dots"><span></span><span></span><span></span></div><span>julio@dev ~</span><span>⌘</span></div>
    <div class="terminal-body"><p><span class="terminal-prompt">❯</span> <span data-terminal-text>const engineer = new JulioCesar();</span><span class="terminal-cursor">▍</span></p><p class="terminal-output">→ {label}</p></div>
    <div class="terminal-status"><span><i></i> SYSTEM ONLINE</span><span>UTF-8 / developer.ts</span></div>
  </div>
</div>
<script>
  const output = document.querySelector<HTMLElement>('[data-terminal-text]');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (output && !motion.matches) {
    const lines = ['const engineer = new JulioCesar();', 'await engineer.build(reliableAPIs);', 'git commit -m "ideas into reality"', 'while (curious) { learn(); create(); }', 'python -m automation.run'];
    let line = 0;
    let position = lines[0].length;
    let removing = true;
    let timer: ReturnType<typeof setTimeout>;
    const tick = () => {
      if (motion.matches) { output.textContent = lines[0]; return; }
      if (document.hidden) { timer = setTimeout(tick, 500); return; }
      position += removing ? -1 : 1;
      output.textContent = lines[line].slice(0, position);
      let delay = removing ? 25 : 65;
      if (position === 0) { removing = false; line = (line + 1) % lines.length; delay = 300; }
      if (position === lines[line].length && !removing) { removing = true; delay = 2400; }
      timer = setTimeout(tick, delay);
    };
    timer = setTimeout(tick, 2400);
    window.addEventListener('pagehide', () => clearTimeout(timer), { once: true });
  }
</script>

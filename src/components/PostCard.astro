---
import type { CollectionEntry } from 'astro:content';
import { copy } from '@/data/site';
import { localeMeta, type Locale } from '@/i18n';
import { postUrl } from '@/utils/blog';

interface Props { post: CollectionEntry<'blog'>; readingTime?: number; }
const { post, readingTime } = Astro.props;
const locale = post.data.locale as Locale;
const t = copy[locale];
---

<article class="post-card" data-spotlight data-post-card data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
  <p class="post-meta">{post.data.pubDate.toLocaleDateString(localeMeta[locale].intl, { dateStyle: 'medium' })}</p>
  <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="post-footer">
    <div class="tag-list">
      {post.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
      {readingTime && <span class="tag">{readingTime} {t.ui.minRead}</span>}
    </div>
    <span class="post-arrow" aria-hidden="true">↗</span>
  </div>
</article>

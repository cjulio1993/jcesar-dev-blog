---
import { copy } from '@/data/site';
import { series } from '@/data/series';
import { calculateReadingTime, formatPostDate, postUrl, type Post } from '@/utils/blog';

interface Props {
  post: Post;
  /** `lead` renders the large, two-column card used for the newest article. */
  variant?: 'default' | 'lead';
}
const { post, variant = 'default' } = Astro.props;
const { locale, title, description, tags, pubDate, draft } = post.data;
const t = copy[locale];
const readingTime = calculateReadingTime(post.body);
const seriesTitle = post.data.series ? series[post.data.series].title[locale] : undefined;
const searchText = [title, description, ...tags, seriesTitle ?? ''].join(' ');
const visibleTags = tags.slice(0, variant === 'lead' ? 4 : 2);
---

<article
  class:list={['post-card', { 'post-card--lead': variant === 'lead' }]}
  data-spotlight
  data-post-card
  data-search={searchText}
  data-tags={JSON.stringify(tags)}
>
  <p class="post-meta">
    <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate, locale)}</time>
    <span class="sep" aria-hidden="true">/</span>
    <span>{readingTime} {t.ui.minRead}</span>
    {draft && <span class="post-badge draft">{t.ui.draft}</span>}
    {seriesTitle && <span class="post-badge">{seriesTitle}</span>}
  </p>
  <h3><a href={postUrl(post)}>{title}</a></h3>
  <p class="post-description">{description}</p>
  <div class="post-footer">
    <div class="tag-list">{visibleTags.map((tag) => <span class="tag">{tag}</span>)}</div>
    {variant === 'lead' ? <span class="read-more" aria-hidden="true">{t.ui.read} →</span> : <span class="post-arrow" aria-hidden="true">↗</span>}
  </div>
</article>

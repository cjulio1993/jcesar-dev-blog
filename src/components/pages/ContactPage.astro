---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { copy, socialLinks } from '@/data/site';
import { localizedPath, type Locale } from '@/i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = copy[locale];
const canonical = `https://jcesar.dev.br${localizedPath(locale, 'contact')}`;
---
<BaseLayout title={`${t.nav.contact} | Julio Cesar`} description={t.contact.text} canonical={canonical}>
  <section class="section container-shell contact-grid">
    <div class="contact-main" data-reveal>
      <div><p class="eyebrow">{t.nav.contact}</p><h1>{t.contact.title}</h1></div>
      <div><p>{t.contact.text}</p><p class="post-meta">{t.contact.response}</p></div>
    </div>
    <div class="contact-cards">
      <a class="contact-link" href={socialLinks.email} data-reveal><div><small>Email</small><strong>{t.contact.emailLabel}</strong></div><span>↗</span></a>
      <a class="contact-link" href={socialLinks.linkedin} target="_blank" rel="noreferrer" data-reveal><div><small>LinkedIn</small><strong>{t.contact.linkedinLabel}</strong></div><span>↗</span></a>
      <a class="contact-link" href={socialLinks.github} target="_blank" rel="noreferrer" data-reveal><div><small>GitHub</small><strong>{t.contact.githubLabel}</strong></div><span>↗</span></a>
    </div>
  </section>
</BaseLayout>


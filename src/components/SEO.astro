---
import { buildSeo } from '@/utils/seo';
import { localeFromPath, localeMeta, locales, switchLocalePath } from '@/i18n';

interface Props {
  title: string;
  description: string;
  canonical: string;
  type?: 'website' | 'article';
  image?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  structuredData?: Record<string, unknown>;
}

const seo = buildSeo(Astro.props as Props);
const locale = localeFromPath(Astro.url.pathname);
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
{locales.map((item) => <link rel="alternate" hreflang={localeMeta[item].html} href={`https://jcesar.dev.br${switchLocalePath(Astro.url.pathname, item)}`} />)}
<link rel="alternate" hreflang="x-default" href={`https://jcesar.dev.br${switchLocalePath(Astro.url.pathname, 'en')}`} />
<meta name="robots" content="index,follow,max-image-preview:large" />
<meta name="generator" content={Astro.generator} />
<meta name="author" content="Julio Cesar" />
<meta property="og:site_name" content="Julio Cesar — Software Engineer" />
<meta property="og:locale" content={localeMeta[locale].html.replace('-', '_')} />
<meta property="og:type" content={seo.type} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={seo.image} />
<meta property="og:image:alt" content={seo.title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.title} />
<meta name="twitter:description" content={seo.description} />
<meta name="twitter:image" content={seo.image} />
{seo.publishedTime && <meta property="article:published_time" content={seo.publishedTime} />}
{seo.modifiedTime && <meta property="article:modified_time" content={seo.modifiedTime} />}
{seo.tags.map((tag) => <meta property="article:tag" content={tag} />)}
{Astro.props.structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(Astro.props.structuredData)} />}

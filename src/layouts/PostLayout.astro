---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import { copy } from '@/data/site';
import { localeMeta, localizedPath, type Locale } from '@/i18n';
import { cleanPostSlug, relatedPosts } from '@/utils/blog';

interface Props { post: CollectionEntry<'blog'>; allPosts: CollectionEntry<'blog'>[]; readingTime: number; }
const { post, allPosts, readingTime } = Astro.props;
const locale = post.data.locale as Locale;
const t = copy[locale];
const postCanonical = `https://jcesar.dev.br${localizedPath(locale, 'blog')}${cleanPostSlug(post)}/`;
const related = relatedPosts(post, allPosts);
const structuredData = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title,
  description: post.data.description, datePublished: post.data.pubDate,
  dateModified: post.data.updatedDate ?? post.data.pubDate,
  inLanguage: localeMeta[locale].html,
  author: { '@type': 'Person', name: 'Julio Cesar', url: 'https://jcesar.dev.br/about/' },
  mainEntityOfPage: postCanonical
};
---

<BaseLayout title={`${post.data.title} | Julio Cesar`} description={post.data.description} canonical={postCanonical} type="article" publishedTime={post.data.pubDate.toISOString()} modifiedTime={(post.data.updatedDate ?? post.data.pubDate).toISOString()} tags={post.data.tags} structuredData={structuredData}>
  <article class="article-shell">
    <a class="article-back" href={localizedPath(locale, 'blog')}>← {t.ui.backToBlog}</a>
    <header class="article-header">
      <p class="post-meta">{post.data.pubDate.toLocaleDateString(localeMeta[locale].intl, { dateStyle: 'long' })} · {readingTime} {t.ui.minRead}</p>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="tag-list">{post.data.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
    </header>
    <div class="article-body prose prose-zinc max-w-none dark:prose-invert"><slot /></div>
  </article>
  {related.length > 0 && <section class="container-shell section-compact"><p class="eyebrow">{t.blog.featured}</p><div class="post-grid">{related.map((item) => <PostCard post={item} />)}</div></section>}
</BaseLayout>
